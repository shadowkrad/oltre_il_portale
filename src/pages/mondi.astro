---
import Base from '../layouts/Base.astro';
import RealmCard from '../components/RealmCard.astro';
import { realms } from '../config/content.js';
---
<Base title="I Due Regni" description="Le Terre Emerse e il Sottomondo: le due dimensioni di Oltre il Portale.">
  <header class="page-title container">
    <h1>La Frattura tra i Due Regni</h1>
    <p>Una spaccatura arcana ha diviso l'esistenza in due dimensioni speculari.</p>
  </header>

  <section class="section container" data-tabs>
    <div class="tabs" role="tablist">
      {realms.map((r) => (
        <button class="mc-btn" role="tab" data-tab={r.id} aria-selected="false">{r.name}</button>
      ))}
    </div>
    {realms.map((r) => (
      <div class="pane" data-pane={r.id} id={r.id} role="tabpanel">
        <RealmCard realm={r}>
          <a class="mc-btn primary" href="/mappa/">Vedi sulla mappa</a>
        </RealmCard>
      </div>
    ))}
  </section>
</Base>
