---
import Base from '../layouts/Base.astro';
import RealmCard from '../components/RealmCard.astro';
import { realms } from '../config/content.js';
---
<Base title="Le Dimensioni" description="Le Terre Emerse, il Sottosopra e la Dimensione X: le tre dimensioni di Oltre il Portale.">
  <header class="page-title container">
    <h1>Tre dimensioni, un solo mondo</h1>
    <p>Quello che costruisci in superficie ha un riflesso sotto di te, e un'ombra oltre il vuoto.</p>
  </header>

  <section class="section container" data-tabs>
    <div class="tabs" role="tablist">
      {realms.map((r) => (
        <button class="mc-btn" role="tab" data-tab={r.id} aria-selected="false">{r.name}</button>
      ))}
    </div>
    {realms.map((r) => (
      <div class="pane" data-pane={r.id} role="tabpanel">
        <RealmCard realm={r}>
          <a class="mc-btn primary" href="/mappa/">Vedi sulla mappa</a>
        </RealmCard>
      </div>
    ))}
  </section>
</Base>
