---
import Base from '../layouts/Base.astro';
import { address, site } from '../config/site.js';
import { steps, bedrockSteps, faq } from '../config/content.js';

const bedrock = site.bedrock;
const bedrockAddress = `${bedrock.host}:${bedrock.port}`;
const guides = [
  { id: 'java', label: '☕ Java Edition', steps, version: `versione ${site.version}` },
  ...(bedrock.enabled ? [{ id: 'bedrock', label: '📱 Bedrock', steps: bedrockSteps, version: `Windows · mobile · console · versioni ${bedrock.versions}` }] : []),
];
---
<Base title="Come Entrare" description={`Guida per entrare in Oltre il Portale da Java e da Bedrock: ${address}.`}>
  <header class="page-title container">
    <h1>Come Entrare</h1>
    <p>Il server è <strong>multipiattaforma</strong>: scegli la tua versione di Minecraft.</p>
  </header>

  <section class="section container" data-tabs>
    <div class="tabs" role="tablist">
      {guides.map((g) => <button class="mc-btn" role="tab" data-tab={g.id} aria-selected="false">{g.label}</button>)}
    </div>

    {guides.map((g) => (
      <div class="pane" data-pane={g.id} role="tabpanel">
        <p class="center" style="color:var(--ink-dim)">{g.version}</p>
        <div class="steps">
          {g.steps.map((s) => (
            <div class="panel step">
              <div>
                <h3>{s.title}</h3>
                <p set:html={s.text} />
                {s.ip && (
                  <div>
                    <code class="code-ip">{site.host}</code>
                    <button class="mc-btn sm" data-copy={site.host}>📋 Copia</button>
                  </div>
                )}
                {s.joinLink && (
                  <a class="mc-btn primary" href={bedrock.joinUrl} target="_blank" rel="noopener noreferrer">📱 Apri la pagina di accesso Bedrock</a>
                )}
                {s.bedrock && (
                  <div>
                    <code class="code-ip">{bedrock.host}</code>
                    <button class="mc-btn sm" data-copy={bedrock.host}>📋 Indirizzo</button>
                    <br />
                    <code class="code-ip">{bedrock.port}</code>
                    <button class="mc-btn sm" data-copy={String(bedrock.port)}>📋 Porta</button>
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
        <div class="panel center mt">
          <h2>Fatto? Ci vediamo dall'altra parte.</h2>
          <p>Stato attuale: <strong data-bind="state">…</strong> · <span data-bind="players">–</span> giocatori online</p>
          <div class="cta-row">
            <button class="mc-btn primary lg" data-copy={g.id === 'bedrock' ? bedrockAddress : address}>📋 Copia {g.id === 'bedrock' ? bedrockAddress : address}</button>
            <a class="mc-btn lg" href="/regolamento/">Leggi il regolamento</a>
          </div>
        </div>
      </div>
    ))}
  </section>

  <section class="section container">
    <div class="section-head"><h2>Domande frequenti</h2></div>
    {faq.map((f) => (
      <details class="panel faq">
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
    <p class="center mt">Hai ancora dubbi? <a href={site.discord} target="_blank" rel="noopener noreferrer">Scrivici su Discord</a>.</p>
  </section>
</Base>
