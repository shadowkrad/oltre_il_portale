---
import Base from '../layouts/Base.astro';
import { site } from '../config/site.js';
import { places } from '../config/content.js';

const icons = { portal: '🌀', city: '🏰', rift: '⚡', ruin: '🗿', abyss: '🕳️' };
const labels = { portal: 'Portale', city: 'Città', rift: 'Torri e cripte', ruin: 'Rovine', abyss: 'Abisso' };

const live = site.liveMapUrl;
const liveTabs = live
  ? site.liveMaps.map((m) => ({ id: m.id, label: m.label, url: `${live}/?worldname=${m.world}&mapname=${m.map}` }))
  : [];
const tabs = [...liveTabs, { id: 'illustrata', label: '🗺️ Mappa illustrata' }];
---
<Base title="Mappa" description="La mappa del reame di Oltre il Portale: dal vivo e illustrata.">
  <header class="page-title container">
    <h1>Mappa del Reame</h1>
    <p>{live ? 'Scegli la dimensione: le mappe dal vivo mostrano il mondo così com’è adesso.' : 'Trascina per muoverti, rotella per zoomare, clicca i luoghi per i dettagli.'}</p>
  </header>

  <section class="section container" data-tabs>
    {tabs.length > 1 && (
      <div class="tabs" role="tablist">
        {tabs.map((t) => <button class="mc-btn" role="tab" data-tab={t.id} aria-selected="false">{t.label}</button>)}
      </div>
    )}

    {liveTabs.map((t) => (
      <div class="pane" data-pane={t.id} role="tabpanel">
        <iframe class="map-embed" src={t.url} title={`Mappa live: ${t.label}`} loading="lazy"></iframe>
        <p class="center mt"><a class="mc-btn" href={t.url} target="_blank" rel="noopener noreferrer">⛶ Apri la mappa a schermo intero</a></p>
      </div>
    ))}

    <div class="pane" data-pane="illustrata" role="tabpanel">
      <div class="map-layout">
        <div>
          <div id="map" data-places={JSON.stringify(places)} data-icons={JSON.stringify(icons)}></div>
          <div class="coords">X: <span id="cx">–</span> · Z: <span id="cz">–</span> · mappa illustrativa, non è il mondo reale</div>
        </div>
        <aside class="panel map-side" aria-label="Luoghi">
          <div class="filters" id="filters">
            {Object.entries(labels).map(([k, v]) => (
              <button type="button" data-type={k} aria-pressed="true">{icons[k]} {v}</button>
            ))}
          </div>
          {places.map((p) => (
            <button type="button" class="place-btn" data-place={p.id} data-type={p.type}>
              <span>{icons[p.type]}</span><span>{p.name}</span>
            </button>
          ))}
        </aside>
      </div>
    </div>
  </section>

  <script>
    import L from 'leaflet';
    import 'leaflet/dist/leaflet.css';
    import { drawRealmMap } from '../scripts/mapart.js';

    const el = document.getElementById('map');
    const built = el ? init(el) : null;

    // La mappa illustrata nasce dentro una scheda nascosta: va ricalibrata quando diventa visibile.
    function refit() {
      if (!built) return;
      setTimeout(() => {
        built.map.invalidateSize();
        built.map.fitBounds(built.bounds);
      }, 60);
    }
    document.querySelectorAll('[data-tab="illustrata"]').forEach((b) => b.addEventListener('click', refit));
    if (location.hash === '#illustrata') refit();

    function init(el) {
      const places = JSON.parse(el.dataset.places);
      const icons = JSON.parse(el.dataset.icons);
      const SIZE = 1000;
      const bounds = [[0, 0], [SIZE, SIZE]];

      const canvas = document.createElement('canvas');
      drawRealmMap(canvas, places);

      const map = L.map(el, { crs: L.CRS.Simple, minZoom: -1.5, maxZoom: 2, zoomSnap: 0.25, maxBounds: [[-100, -100], [SIZE + 100, SIZE + 100]], attributionControl: false });
      L.imageOverlay(canvas.toDataURL(), bounds).addTo(map);
      map.fitBounds(bounds);

      // y della griglia cresce verso il basso, Leaflet verso l'alto
      const toLatLng = (p) => [SIZE - p.y, p.x];
      const markers = {};
      for (const p of places) {
        const icon = L.divIcon({
          className: '',
          html: `<div class="map-pin ${p.type === 'portal' ? 'pulse' : ''}">${icons[p.type]}</div>`,
          iconSize: [28, 28],
          iconAnchor: [14, 14],
        });
        const m = L.marker(toLatLng(p), { icon, title: p.name }).addTo(map);
        const box = document.createElement('div');
        const b = document.createElement('b');
        b.textContent = p.name;
        const t = document.createElement('span');
        t.textContent = p.text;
        box.append(b, t);
        m.bindPopup(box, { maxWidth: 240 });
        markers[p.id] = m;
      }

      const btns = [...document.querySelectorAll('.place-btn')];
      btns.forEach((b) =>
        b.addEventListener('click', () => {
          const p = places.find((x) => x.id === b.dataset.place);
          btns.forEach((o) => o.classList.toggle('active', o === b));
          map.flyTo(toLatLng(p), 1, { duration: 0.8 });
          markers[p.id].openPopup();
        }),
      );

      document.querySelectorAll('#filters button').forEach((f) =>
        f.addEventListener('click', () => {
          const on = f.getAttribute('aria-pressed') !== 'true';
          f.setAttribute('aria-pressed', String(on));
          const type = f.dataset.type;
          places.filter((p) => p.type === type).forEach((p) => (on ? markers[p.id].addTo(map) : markers[p.id].remove()));
          btns.filter((b) => b.dataset.type === type).forEach((b) => (b.style.display = on ? '' : 'none'));
        }),
      );

      map.on('mousemove', (e) => {
        document.getElementById('cx').textContent = Math.round(e.latlng.lng - SIZE / 2) * 4;
        document.getElementById('cz').textContent = Math.round(SIZE / 2 - e.latlng.lat) * 4;
      });

      return { map, bounds };
    }
  </script>
</Base>
