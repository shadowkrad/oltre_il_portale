---
import Base from '../layouts/Base.astro';
import { site } from '../config/site.js';

const live = site.liveMapUrl;
const tabs = live ? site.liveMaps.map((m) => ({ id: m.id, label: m.label, url: `${live}/?worldname=${m.world}&mapname=${m.map}` })) : [];
---
<Base title="Mappa" description="La mappa dal vivo di Oltre il Portale: Terre Emerse, Sottosopra e Dimensione X.">
  <header class="page-title container">
    <h1>Mappa</h1>
    <p>Scegli la dimensione: la mappa mostra il mondo così com’è adesso.</p>
  </header>

  <section class="section container" data-tabs>
    {tabs.length === 0 ? (
      <p class="center">La mappa non è disponibile al momento.</p>
    ) : (
      <>
        <div class="tabs" role="tablist">
          {tabs.map((t) => <button class="mc-btn" role="tab" data-tab={t.id} aria-selected="false">{t.label}</button>)}
        </div>
        {tabs.map((t) => (
          <div class="pane" data-pane={t.id} role="tabpanel">
            <iframe class="map-embed" src={t.url} title={`Mappa live: ${t.label}`} loading="lazy"></iframe>
            <p class="center mt"><a class="mc-btn" href={t.url} target="_blank" rel="noopener noreferrer">⛶ Apri a schermo intero</a></p>
          </div>
        ))}
      </>
    )}
  </section>
</Base>
