---
import Base from '../layouts/Base.astro';
import { pillars } from '../config/content.js';
---
<Base title="Gameplay" description="Città vive, incarichi, torri e cripte, Sottosopra, Dimensione X e ferrovie a vapore: cosa trovi in Oltre il Portale.">
  <header class="page-title container">
    <h1>Cosa trovi nel mondo</h1>
    <p>Un territorio generato da una mappa vera e riempito di luoghi, creature e storie.</p>
  </header>
  <section class="section container">
    <div class="grid">
      {pillars.map((p) => (
        <article class="panel card reveal" id={p.id}>
          <h3><span class="ico">{p.icon}</span>{p.title}</h3>
          <p>{p.text}</p>
          {p.bullets.length > 0 && <ul class="checks">{p.bullets.map((b) => <li>{b}</li>)}</ul>}
        </article>
      ))}
    </div>
    <div class="center mt"><a class="mc-btn primary lg" href="/istruzioni/">▶ Inizia l'avventura</a></div>
  </section>
</Base>
