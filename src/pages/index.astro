---
import Base from '../layouts/Base.astro';
import ServerStatus from '../components/ServerStatus.astro';
import BulbWall from '../components/BulbWall.astro';
import { site, address } from '../config/site.js';
import { realms } from '../config/content.js';

const phrases = ['Esplora le Terre Emerse.', 'Sotto ogni città ce n’è un’altra.', 'Non tutto ciò che vedi è reale.', 'Qualcuno ti sta aspettando nel Sottosopra.', 'Nessun pay-to-win. Mai.'];
const icons = { overworld: '🌳', sottosopra: '🌋', 'dimensione-x': '🕰️' };
const targets = { overworld: '/mondo/', sottosopra: '/sottosopra/', 'dimensione-x': '/mondo/' };
const video = site.videoUrl;
---
<Base>
  <section class="hero container">
    <h1 class="logo">OLTRE<span>IL PORTALE</span></h1>
    <div class="typed-wrap" data-typewriter={JSON.stringify(phrases)} aria-label={phrases.join(' ')}></div>
    <p class="only-upside warn">⚠ Sei nel Sottosopra. Non guardare indietro.</p>
    <div class="ip-box">
      <span class="ip">{address}</span>
      <button class="mc-btn" data-copy={address}>📋 Copia IP</button>
    </div>
    {site.bedrock.enabled && <p class="platforms"><span class="pill">☕ Java · 📱 Bedrock · multipiattaforma</span></p>}
    <div class="cta-row">
      <a href="/istruzioni/" class="mc-btn primary lg">▶ Come Entrare</a>
      <a href="/mappa/" class="mc-btn lg">🗺 Mappa</a>
    </div>
  </section>

  <section class="section container reveal">
    <ServerStatus />
  </section>

  <section class="section container reveal">
    <div class="section-head"><h2>Tre dimensioni</h2></div>
    <div class="grid">
      {realms.map((r) => (
        <a class="panel tile" href={targets[r.id]} style="text-decoration:none;color:inherit">
          <span class="ico">{icons[r.id]}</span>
          <h3>{r.name}</h3>
          <p>{r.tag}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="section container reveal">
    <div class="panel dark upside-teaser">
      <p class="eyebrow">📼 Per chi ama Stranger Things</p>
      <h2 class="flicker">Qualcosa si muove sotto di noi</h2>
      <p>Sotto ogni città c’è un’altra città, identica e corrotta: il <strong>Sottosopra</strong>. Leggi cosa vuole dirti.</p>
      <BulbWall messages={['SIAMO QUI SOTTO', 'NON FIDARTI DEL PORTALE', 'CORRI', 'TI STIAMO ASPETTANDO']} />
      <div class="cta-row">
        <a class="mc-btn primary lg" href="/sottosopra/">🔦 Scopri il Sottosopra</a>
      </div>
    </div>
  </section>

  {video && (
    <section class="section container reveal">
      <div class="section-head"><h2>Il video ufficiale</h2></div>
      <iframe class="video" src={video} title="Video ufficiale Oltre il Portale" allow="accelerometer; encrypted-media; picture-in-picture; fullscreen" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen loading="lazy"></iframe>
      <p class="center mt"><a href={site.videoWatchUrl} target="_blank" rel="noopener noreferrer">Guardalo su YouTube</a></p>
    </section>
  )}
</Base>
